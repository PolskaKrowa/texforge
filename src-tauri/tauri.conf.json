{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TexForge",
  "version": "0.1.0",
  "identifier": "com.texforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TexForge",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "LaTeX editor with live preview",
    "longDescription": "TexForge is a lightweight LaTeX editor with syntax highlighting, a live PDF preview, Beamer slide management and reusable document templates.",
    "copyright": "Copyright © 2025 TexForge contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
